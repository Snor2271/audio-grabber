# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model for AI naming suggestion (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default: 3000)
PORT=3000

# Server Host: "0.0.0.0" allows devices on the same Wi-Fi (iPhone/Android) to access.
# Set to "127.0.0.1" if you only want local machine access.
HOST="0.0.0.0"

# Optional: Extract YouTube cookies directly from local browser (chrome, firefox, edge, safari, brave)
# YTDLP_COOKIES_FROM_BROWSER="chrome"

# Optional: Path to exported cookies.txt file
# YTDLP_COOKIES_FILE="./cookies.txt"

# Optional: Proxy URL (HTTP/HTTPS/SOCKS5)
# YTDLP_PROXY="http://127.0.0.1:1080"
